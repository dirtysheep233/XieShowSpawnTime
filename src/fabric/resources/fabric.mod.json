{
  "schemaVersion": 1,
  "id": "xieshowspawntime",
  "version": "${version}",
  "name": "Xie Show Spawn Time",
  "description": "a Function Zombies spawn timer and QoL HUD for Fabric.",
  "authors": [
    "SeoSean"
  ],
  "contact": {
    "sources": "https://github.com/dirtysheep233/ShowSpawnTime"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.seosean.showspawntime.ShowSpawnTimeClient"
    ]
  },
  "mixins": [
    "showspawntime.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
